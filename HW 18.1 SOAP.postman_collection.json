  "item": [
    {
      "name": "Book ISBN Numbers",
      "item": [
        {
          "name": "Is Valid ISBN13 Number",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"1. Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"2. Status text is OK\", function () {\r",
                  "    pm.response.to.have.status(\"OK\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"3. Response time is less than 5000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"4. Content-Type header is present\", function () {\r",
                  "    pm.response.to.have.header(\"Content-Type\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"5. Content-Type includes text/xml\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"6. Body contains SOAP Envelope tag\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"Envelope\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"7. Body contains SOAP Body tag\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"Body\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"8. Body contains IsValidISBN13Response\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"IsValidISBN13Response\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"9. Body contains IsValidISBN13Result\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"IsValidISBN13Result\");\r",
                  "});\r",
                  "\r",
                  "// Найголовніший тест для SOAP - перевірка, чи може Postman прочитати XML і перетворити його в JSON об'єкт\r",
                  "pm.test(\"10. Convert XML to JSON successfully\", function () {\r",
                  "    var jsonObject = xml2Json(pm.response.text());\r",
                  "    pm.expect(jsonObject).to.be.an('object');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
            },
            "url": {
              "raw": "http://webservices.daehosting.com/services/isbnservice.wso",
              "protocol": "http",
              "host": [
                "webservices",
                "daehosting",
                "com"
              ],
              "path": [
                "services",
                "isbnservice.wso"
              ]
            },
            "description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
          },
          "response": []
        },
